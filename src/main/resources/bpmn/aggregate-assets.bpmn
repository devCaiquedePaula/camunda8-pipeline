        <dc:Bounds x="400" y="340" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Err_alpha_di" bpmnElement="Err_alpha">
        <dc:Bounds x="412" y="402" width="36" height="36" />
