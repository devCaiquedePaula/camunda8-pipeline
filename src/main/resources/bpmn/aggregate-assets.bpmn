      <bpmndi:BPMNShape id="ScriptFailed_alpha_di" bpmnElement="ScriptFailed_alpha">
        <dc:Bounds x="370" y="470" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ScriptTimeout_alpha_di" bpmnElement="ScriptTimeout_alpha">
        <dc:Bounds x="480" y="470" width="100" height="60" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Merge_alpha_di" bpmnElement="Merge_alpha">
        <dc:Bounds x="655" y="355" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_split_alpha_di" bpmnElement="Flow_split_alpha">
        <di:waypoint x="295" y="380" />
        <di:waypoint x="400" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ok_alpha_di" bpmnElement="Flow_ok_alpha">
        <di:waypoint x="520" y="380" />
        <di:waypoint x="655" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_err_alpha_di" bpmnElement="Flow_err_alpha">
