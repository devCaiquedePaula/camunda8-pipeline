      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_di" bpmnElement="Flow_Start">
        <di:waypoint x="198" y="380" />
        <di:waypoint x="245" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="Join_di" bpmnElement="Join">
